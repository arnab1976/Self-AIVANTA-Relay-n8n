# ---- AIVANTA Relay (n8n workflow automation) ----
APP_NAME=AIVANTA Relay
ENVIRONMENT=development
DATABASE_URL=sqlite:///./aivanta.db          # postgresql://user:pass@host:5432/aivanta in staging/prod
STORAGE_DIR=./.data/objects
CORS_ORIGINS=http://localhost:3000
SEED_DEMO=true                                 # three demo tenants, projects and canvases
RUN_EXECUTION=inline                           # inline | worker (multi-replica: worker + python -m aivanta_api.worker)

# ---- Auth ----
AUTH_MODE=dev                                  # dev | oidc
JWT_SECRET=replace-with-a-long-random-string-for-dev-tokens
# OIDC / Entra ID (AUTH_MODE=oidc)
OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_AUDIENCE=api://aivanta
OIDC_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
OIDC_TENANT_CLAIM=aivanta_tenant
OIDC_ROLES_CLAIM=roles
ROLE_GROUP_MAP={"<entra-group-object-id>":"finance"}

# ---- Models ----
LLM_PROVIDER=mock                              # mock | openai | azure_openai | ollama
OPENAI_API_KEY=
OPENAI_BASE_URL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
OLLAMA_BASE_URL=http://localhost:11434
# model profile -> provider model (azure: deployment name)
MODEL_ENTERPRISE_REASONING=gpt-4o
MODEL_ENTERPRISE_FAST=gpt-4o-mini
MODEL_LOCAL_OPEN_WEIGHT=llama3.1:8b
EMBEDDINGS_PROVIDER=hash                       # hash | openai

# ---- Runtime ----
N8N_MODE=emulated                              # emulated (in-process, tests/laptop) | rest (real n8n)
N8N_API_URL=http://localhost:5678/api/v1
N8N_API_KEY=                                   # n8n → Settings → n8n API → Create API key (or make n8n-bootstrap)
N8N_WEBHOOK_URL=http://localhost:5678
AIVANTA_BRIDGE_URL=http://localhost:8000        # how n8n reaches this API
AIVANTA_BRIDGE_TOKEN=replace-with-a-long-random-bridge-token
RELAY_AGENT_MODE=native                         # native (n8n AI Agent node + AIVANTA model gateway) | service
N8N_RUN_TIMEOUT_SECONDS=1800
N8N_TENANT_INSTANCES=                           # optional dedicated n8n per tenant, JSON
N8N_ENCRYPTION_KEY=replace-with-a-32-char-random-key!!   # n8n credential encryption (docker compose)
N8N_IMAGE_TAG=2.45.7
N8N_OWNER_EMAIL=ops@example.com                 # used by make n8n-bootstrap

# ---- SaaS / provider ----
PROVIDER_ROLE=aivanta-provider                  # OIDC role/group that marks Provider Admins
PUBLIC_TENANT_DIRECTORY=true                    # list tenants on Request Access (false = type the tenant code)

# ---- Connectors (optional; built-in connectors are used when unset) ----
MCP_GATEWAY_URL=
MCP_GATEWAY_TOKEN=
HRMS_URL=
HRMS_TOKEN=
JIRA_URL=
JIRA_TOKEN=
JIRA_PROJECT_KEY=AIV
CLAMAV_HOST=
CLAMAV_PORT=3310
